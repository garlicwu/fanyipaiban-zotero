# Copy this file to .env for local Zotero integration testing.

# Windows example: C:\\Program Files\\Zotero\\zotero.exe
# macOS example: /Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/path/to/zotero

# Use a dedicated development profile.
ZOTERO_PLUGIN_PROFILE_PATH=/path/to/zotero/profile

# Optional custom Zotero data directory.
ZOTERO_PLUGIN_DATA_DIR=

# Required only when publishing a release locally.
GITHUB_TOKEN=
