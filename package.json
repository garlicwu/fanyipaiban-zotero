{
  "name": "fanyipaiban-zotero",
  "type": "module",
  "version": "0.1.1",
  "description": "Translate complete PDFs in Zotero while preserving the original document layout.",
  "config": {
    "addonName": "FanyiPaiban PDF Translator",
    "addonID": "fanyipaiban@fanyipaiban.com",
    "addonRef": "fanyipaiban",
    "addonInstance": "FanyiPaiban",
    "prefsPrefix": "extensions.zotero.fanyipaiban"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garlicwu/fanyipaiban-zotero.git"
  },
  "author": "FanyiPaiban",
  "engines": {
    "node": ">=22.8.0"
  },
  "bugs": {
    "url": "https://github.com/garlicwu/fanyipaiban-zotero/issues"
  },
  "homepage": "https://github.com/garlicwu/fanyipaiban-zotero",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write . && eslint . --fix",
    "test": "npm run test:unit",
    "test:unit": "tsx --test unit-tests/apiClient.test.ts unit-tests/files.test.ts unit-tests/idempotency.test.ts",
    "test:zotero": "zotero-plugin test",
    "verify": "npm run lint && npm run test:unit && npm run build",
    "release": "zotero-plugin release",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.0",
    "@zotero-plugin/eslint-config": "0.6.7",
    "chai": "6.2.1",
    "eslint": "9.39.2",
    "mocha": "11.7.5",
    "prettier": "3.7.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "zotero-plugin-scaffold": "0.8.2",
    "zotero-types": "4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
